# --- Font ---
font-family = "JetBrainsMono Nerd Font"
font-size = 13.5

# --- Appearance ---
background-opacity = 0.70
window-padding-x = 14
window-padding-y = 14

# optional (platform dependent)
background-blur-radius = 30

# --- Cursor ---
cursor-style = block

# --- Scrolling ---
scrollback-limit = 10000

# --- Mouse ---
mouse-hide-while-typing = true

# AeroSpace uses Left Option for window commands. Remap it inside Ghostty
# before Ghostty's rectangular-selection check so Option+Shift stays available
# to AeroSpace. Right Option retains normal Option and rectangle selection.
# Requires Ghostty 1.3.0 or newer.
key-remap = left_alt=left_ctrl

# --- Shell integration ---
shell-integration = detect

# --- Colors (Catppuccin Mocha) ---
background = #1e1e2e
foreground = #cdd6f4

cursor-color = #f38ba8
selection-background = #585b70
selection-foreground = #cdd6f4

# ANSI colors
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#bac2de

palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#a6adc8

# --- Keybindings ---
# Herdr owns tabs, panes, workspaces, navigation, zoom, and resize actions.
# Clear Ghostty's defaults so every unlisted shortcut reaches Herdr or the
# application running in its focused pane.
keybind = clear

# Ghostty configuration
keybind = super+,=open_config
keybind = super+shift+,=reload_config

# Clipboard
keybind = super+c=copy_to_clipboard:mixed
keybind = super+v=paste_from_clipboard

# Font size
keybind = super+==increase_font_size:1
keybind = super++=increase_font_size:1
keybind = super+-=decrease_font_size:1
keybind = super+0=reset_font_size

# Search
# Match Ghostty's conditional defaults: consume these keys only when the
# corresponding search action can run. In particular, Escape must otherwise
# reach Herdr or the application in its focused pane.
keybind = performable:super+f=start_search
keybind = performable:super+e=search_selection
keybind = performable:super+shift+f=end_search
keybind = performable:escape=end_search
keybind = performable:super+g=navigate_search:next
keybind = performable:super+shift+g=navigate_search:previous

# Application and window controls
keybind = super+n=new_window
keybind = super+enter=toggle_fullscreen
keybind = super+q=quit
